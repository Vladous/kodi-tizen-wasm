<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns="http://tizen.org/ns/packages" api-version="8" package="@APP_PACKAGE@" version="@APP_VERSION_MAJOR@.@APP_VERSION_MINOR@.0">
  <profile name="tv" />
  <ui-application appid="@APP_PACKAGE@" exec="KodiHost.dll" type="dotnet" multiple="false" taskmanage="true" nodisplay="false" launch_mode="single">
    <label>@APP_NAME@</label>
    <icon>kodi.png</icon>
  </ui-application>
  <privileges>
    <privilege>http://tizen.org/privilege/internet</privilege>
    <privilege>http://tizen.org/privilege/mediastorage</privilege>
    <privilege>http://tizen.org/privilege/externalstorage</privilege>
    <privilege>http://tizen.org/privilege/network.get</privilege>
  </privileges>
</manifest>
